# King Sparkon MCP server — local + Vercel configuration.
# Never commit real secrets. Only server configuration lives here.

# Spring Boot backend base URL (no trailing /api; the server appends it).
BACKEND_URL=http://localhost:8080

# Public frontend URL (used in tool responses that link to checkout flows).
APP_URL=http://localhost:3000

# Secret used to sign confirmation tokens for sensitive writes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_CONFIRM_SECRET=change-me-to-a-long-random-secret

# Comma-separated OAuth/consent scopes considered granted when the MCP client
# does not pass explicit per-request consent (use for local dev only).
MCP_DEFAULT_SCOPES=
